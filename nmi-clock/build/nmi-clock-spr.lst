Sections:
00: "org0001:c000" (C000-C23A)


Source: "src/nmi-clock-spr.asm"
                        	     1:         ;; NMI-based clock/timer using sprites
                        	     2:         ;; ===================================
                        	     3:         ;;
                        	     4:         ;; CIA2 timers A+B cascaded -> 1 NMI/second (PAL)
                        	     5:         ;; HH:MM:SS clock (BCD sec/min/hour) displayed with
                        	     6:         ;; 8 sprites in the bottom-right corner of the screen.
                        	     7:         ;; The 8x8 glyphs are copied from the chargen ROM
                        	     8:         ;; ('0'-'9' and ':') into the left column of 11
                        	     9:         ;; 64-byte sprite blocks at $c800.
                        	    10:         ;; -----------------------------------------------
                        	    11:         ;; The VIC-II is switched to bank $c000-$ffff, so it
                        	    12:         ;; sees RAM there: screen at $c400, sprites at $c800,
                        	    13:         ;; sprite pointers at $c7f8-$c7ff.  Before the switch the
                        	    14:         ;; whole chargen charset is copied into the RAM at $d000
                        	    15:         ;; (the CPU reads the chargen ROM at $d000 while writes
                        	    16:         ;; hit the RAM underneath, which the VIC-II then displays
                        	    17:         ;; from bank offset $1000).
                        	    18:         ;; -----------------------------------------------
                        	    19:         ;; Timer A = 20455 (~50.008 Hz on PAL 1.022727 MHz
                        	    20:         ;; CIA clock); timer B counts 50 underflows -> ~1s
                        	    21: 
                        	    22:         ;; Macros
                        	    23:         ;; ------
                        	    24: 
                        	    25:         ;; BNE to distant address
                        	    26: jne:    .macro adr
                        	    27:         beq :+
                        	    28:         jmp \adr
                        	    29: :
                        	    30:         .endm
                        	    31: 
                        	    32:         ;; BCS to distant address
                        	    33: jcs:    .macro adr
                        	    34:         bcc :+
                        	    35:         jmp \adr
                        	    36: :
                        	    37:         .endm
                        	    38: 
                        	    39:         ;; BCD +1 on \val; wrap to 0 at \lim, else branch to \tgt
                        	    40:         ;; (seconds/minutes/hours roll over at 60/60/24)
                        	    41: bump:   .macro val, lim, tgt
                        	    42:         clc
                        	    43:         lda \val
                        	    44:         adc #1
                        	    45:         sta \val
                        	    46:         cmp #\lim
                        	    47:         bne \tgt
                        	    48:         lda #0
                        	    49:         sta \val
                        	    50:         .endm
                        	    51: 
                        	    52:         ;; Copy \np 256-byte pages (ptr1),y -> (\dst),y (\inc2=1
                        	    53:         ;; if the destination is a second pointer needing a bump)
                        	    54: copyblk: .macro dst, np, inc2
                        	    55:         ldx #\np
                        	    56: :
                        	    57:         ldy #0
                        	    58: :
                        	    59:         lda (ptr1),y
                        	    60:         sta (\dst),y
                        	    61:         iny
                        	    62:         bne :-
                        	    63:         inc ptr1+1
                        	    64:         .if \inc2
                        	    65:         inc \dst+1
                        	    66:         .endif
                        	    67:         dex
                        	    68:         bne :--
                        	    69:         .endm
                        	    70: 
                        	    71:         ;; Store word \val (little-endian) at low/high pair \reg
                        	    72: setw:   .macro reg, val
                        	    73:         lda #<\val
                        	    74:         sta \reg
                        	    75:         lda #>\val
                        	    76:         sta \reg+1
                        	    77:         .endm
                        	    78: 
                        	    79:         ;; CIA2 registers
                        	    80:         ;; --------------
                        	    81: ci2pra: .equ $dd00              ;.byte data port register A
                        	    82: c2ddra: .equ $dd02              ;.byte data direction register A
                        	    83: ci2tia: .equ $dd04              ;.word Timer A
                        	    84: ci2tib: .equ $dd06              ;.word Timer B
                        	    85: ci2icr: .equ $dd0d              ;.byte Interrupt ctrl register
                        	    86: ci2cra: .equ $dd0e              ;.byte Timer A ctrl register
                        	    87: ci2crb: .equ $dd0f              ;.byte Timer B ctrl register
                        	    88: 
                        	    89:         ;; VIC-II registers
                        	    90:         ;; -----------------
                        	    91: sprxlo: .equ $d000              ;.byte sprite X positions (low)
                        	    92: sprylo: .equ $d001              ;.byte sprite Y positions
                        	    93: sprxhi: .equ $d010              ;.byte sprite X positions (high)
                        	    94: spena:  .equ $d015              ;.byte sprite enable
                        	    95: vmcsb:  .equ $d018              ;.byte memory ctrl register
                        	    96: sp0col: .equ $d027              ;.byte sprite colors (0-7)
                        	    97: 
                        	    98:         ;; System Memory Locations
                        	    99:         ;; -----------------------
                        	   100: nmivec: .equ $0318              ;kernal indirect NMI vector
                        	   101: hibase: .equ $0288              ;high byte of KERNAL screen base
                        	   102: sprptr: .equ $c7f8              ;sprite pointers (end of screen RAM $c400+$3f8)
                        	   103: glyphs: .equ $c800              ;sprite glyph buffer (11 x 64 bytes)
                        	   104: sprbase:.equ $20                ;glyphs offset $0800 / 64 in VIC bank 3
                        	   105: 
                        	   106:         ;; Sprite anchor = top-left pixel of the first clock cell
                        	   107:         ;; (text row 24, column 32; screen RAM block at $c400).
                        	   108:         ;;
                        	   109:         ;; VIC-II sprite coordinates are measured from the top-left of
                        	   110:         ;; the border, NOT the visible screen.  The visible text area
                        	   111:         ;; starts at sprite coordinate X = 24, Y = 50, so a text cell
                        	   112:         ;; (col,row) maps to:
                        	   113:         ;;     sprite X = 24 + col*8     sprite Y = 50 + row*8
                        	   114:         ;;
                        	   115:         ;; Sprite 0 is the left-most column (32).
                        	   116: sprx0:  .equ 24 + (32*8)            ;sprite 0 X (col 32 -> sprite X 280)
                        	   117: spry0:  .equ 50 + (24*8)            ;sprite Y  (row 24 -> sprite Y 242)
                        	   118: 
                        	   119:         ;; OS routines
                        	   120:         ;; -----------
                        	   121: frmnum: .equ $ad8a              ;eval numeric expression
                        	   122: comma:  .equ $aefd              ;detect comma in BASIC line
                        	   123: facwrd: .equ $b7f7              ;convert FAC #1 to word at linnum
                        	   124: illqua: .equ $b248              ;raise illegal qty error
                        	   125: setpnt: .equ $e56c              ;refresh KERNAL screen/color pointers
                        	   126: 
                        	   127:         ;; OS memory
                        	   128:         ;; ---------
                        	   129: linnum: .ezp $14                ;.word BASIC line number
                        	   130: 
                        	   131:         ;; Temporary working memory (ZP)
                        	   132:         ;; -----------------------------
                        	   133: temp:     .ezp $fa                ;.byte Scratch pad
                        	   134: ptr1:     .ezp $5b                ;.word Scratch pointer
                        	   135: ptr2:     .ezp $5d                ;.word Scratch pointer
                        	   136: 
                        	   137:         .org $c000
                        	   138: 
                        	   139:         ;; Jump table
                        	   140:         ;; ----------
00:C000 4C0CC0          	   141: jtable: jmp settime
00:C003 4C63C0          	   142:         jmp start
00:C006 4C97C0          	   143:         jmp stop
00:C009 4CA0C0          	   144:         jmp restart
                        	   145: 
                        	   146:         ;; Routines
                        	   147:         ;; --------
                        	   148: 
                        	   149:         ;; Routine to set the time from user input
                        	   150:         ;; and start the clock.
                        	   151:         ;; Called from BASIC via jump table entry:
                        	   152:         ;;      SYS(49152) hrs (0-23), min (0-59), sec (0-59)
                        	   153:         ;;
                        	   154:         ;; E.g. SYS(49152) 11,51,20
                        	   155: settime:
                        	   156:         ;; Hours
00:C00C A918            	   157:         lda #24
00:C00E 85FA            	   158:         sta temp
                        	   159:         setw ptr1, hours
00:C010 A937            	     1M         lda #<hours
00:C012 855B            	     2M         sta ptr1
00:C014 A9C2            	     3M         lda #>hours
00:C016 855C            	     4M         sta ptr1+1
00:C018 2042C0          	   160:         jsr setfield$
                        	   161:         ;; Minutes
00:C01B 20FDAE          	   162:         jsr comma
00:C01E A93C            	   163:         lda #60
00:C020 85FA            	   164:         sta temp
                        	   165:         setw ptr1, minutes
00:C022 A938            	     1M         lda #<minutes
00:C024 855B            	     2M         sta ptr1
00:C026 A9C2            	     3M         lda #>minutes
00:C028 855C            	     4M         sta ptr1+1
00:C02A 2042C0          	   166:         jsr setfield$
                        	   167:         ;; Seconds
00:C02D 20FDAE          	   168:         jsr comma
00:C030 A93C            	   169:         lda #60
00:C032 85FA            	   170:         sta temp
                        	   171:         setw ptr1, seconds
00:C034 A939            	     1M         lda #<seconds
00:C036 855B            	     2M         sta ptr1
00:C038 A9C2            	     3M         lda #>seconds
00:C03A 855C            	     4M         sta ptr1+1
00:C03C 2042C0          	   172:         jsr setfield$
00:C03F 4C63C0          	   173:         jmp start
                        	   174: 
                        	   175:         ;; Routine to read one HH:MM:SS field from BASIC, range check it
                        	   176:         ;; against temp and store it as packed BCD in ptr1.
                        	   177:         ;; temp: max value
                        	   178:         ;; ptr1: pointer to location to store value
                        	   179: setfield$:
00:C042 205DC0          	   180:         jsr getwrd$
00:C045 A515            	   181:         lda linnum+1
                        	   182:         jne illqua
00:C047 F003            	     1M         beq :+
00:C049 4C48B2          	     2M         jmp illqua
                        	     3M :
00:C04C A514            	   183:         lda linnum
00:C04E C5FA            	   184:         cmp temp
                        	   185:         jcs illqua
00:C050 9003            	     1M         bcc :+
00:C052 4C48B2          	     2M         jmp illqua
                        	     3M :
00:C055 20B1C0          	   186:         jsr bin2bcd
00:C058 A000            	   187:         ldy #0
00:C05A 915B            	   188:         sta (ptr1),y
00:C05C 60              	   189:         rts  
                        	   190: 
                        	   191: getwrd$:
00:C05D 208AAD          	   192:         jsr frmnum
00:C060 4CF7B7          	   193:         jmp facwrd
                        	   194: 
                        	   195:         ;; Routine to start the NMI timer
                        	   196:         ;; Called from BASIC via jump table entry:
                        	   197:         ;;      SYS49155
                        	   198: start:
00:C063 201AC1          	   199:         jsr initspr      ;; build sprite glyphs, position/enable sprites
                        	   200: 
                        	   201:         setw ci2tia, $4fe7      ;; timer A = 20,455 (PAL)
00:C066 A9E7            	     1M         lda #<$4fe7      
00:C068 8D04DD          	     2M         sta ci2tia
00:C06B A94F            	     3M         lda #>$4fe7      
00:C06D 8D05DD          	     4M         sta ci2tia+1
                        	   202:         setw ci2tib, 50         ;; timer B = 50 A-underflows
00:C070 A932            	     1M         lda #<50         
00:C072 8D06DD          	     2M         sta ci2tib
00:C075 A900            	     3M         lda #>50         
00:C077 8D07DD          	     4M         sta ci2tib+1
00:C07A A911            	   203:         lda #%00010001
00:C07C 8D0EDD          	   204:         sta ci2cra       ;; start timer A
00:C07F A951            	   205:         lda #%01010001
00:C081 8D0FDD          	   206:         sta ci2crb       ;; B counts A underflows, start
                        	   207: 
00:C084 AD0DDD          	   208:         lda ci2icr
00:C087 0982            	   209:         ora #%10000010
00:C089 8D0DDD          	   210:         sta ci2icr       ;; enable timer B -> NMI
                        	   211: 
                        	   212:         setw nmivec, isr        ;; hook NMI
00:C08C A9CC            	     1M         lda #<isr        
00:C08E 8D1803          	     2M         sta nmivec
00:C091 A9C0            	     3M         lda #>isr        
00:C093 8D1903          	     4M         sta nmivec+1
                        	   213: 
00:C096 60              	   214:         rts
                        	   215: 
                        	   216:         ;; Routine to stop the NMI timer
                        	   217:         ;; Called from BASIC via jump table entry:
                        	   218:         ;;      SYS49158
                        	   219: stop:
00:C097 A97F            	   220:         lda #$7f
00:C099 8D0DDD          	   221:         sta ci2icr
00:C09C AD0DDD          	   222:         lda ci2icr
00:C09F 60              	   223:         rts
                        	   224: 
                        	   225:         ;; Routine to stop timer, reset time to 00:00:00
                        	   226:         ;; and then restart timer.
                        	   227:         ;; Called from BASIC via jump table entry:
                        	   228:         ;;      SYS49161
                        	   229: restart:
00:C0A0 2097C0          	   230:         jsr stop
00:C0A3 A900            	   231:         lda #0
00:C0A5 8D37C2          	   232:         sta hours
00:C0A8 8D38C2          	   233:         sta minutes
00:C0AB 8D39C2          	   234:         sta seconds
00:C0AE 4C63C0          	   235:         jmp start
                        	   236: 
                        	   237:         ;; Routine to convert byte in .A to packed BCD
                        	   238: bin2bcd:
00:C0B1 A200            	   239:         ldx #0
00:C0B3 A8              	   240:         tay
                        	   241: tens$:
00:C0B4 C00A            	   242:         cpy #10
00:C0B6 9009            	   243:         bcc ones$
00:C0B8 98              	   244:         tya
00:C0B9 38              	   245:         sec
00:C0BA E90A            	   246:         sbc #10
00:C0BC A8              	   247:         tay
00:C0BD E8              	   248:         inx
00:C0BE 4CB4C0          	   249:         jmp tens$
                        	   250: ones$:
00:C0C1 8A              	   251:         txa
00:C0C2 0A              	   252:         asl
00:C0C3 0A              	   253:         asl
00:C0C4 0A              	   254:         asl
00:C0C5 0A              	   255:         asl
00:C0C6 85FA            	   256:         sta temp
00:C0C8 98              	   257:         tya
00:C0C9 05FA            	   258:         ora temp
00:C0CB 60              	   259:         rts
                        	   260: 
                        	   261:         ;; NMI service routine: called once per second
                        	   262: isr:
                        	   263:         ;; Save x,y,acc
00:C0CC 48              	   264:         pha
00:C0CD 8A              	   265:         txa
00:C0CE 48              	   266:         pha
00:C0CF 98              	   267:         tya
00:C0D0 48              	   268:         pha
                        	   269: 
00:C0D1 AC0DDD          	   270:         ldy ci2icr       ;; read clears pending flag
00:C0D4 98              	   271:         tya
00:C0D5 2902            	   272:         and #$02
00:C0D7 F03B            	   273:         beq exit$
                        	   274: 
00:C0D9 F8              	   275:         sed               ;; BCD +1 second, with 60/60/24 rollover
                        	   276:         bump seconds, $60, done$      ;; seconds < 60: no carry
00:C0DA 18              	     1M         clc
00:C0DB AD39C2          	     2M         lda seconds
00:C0DE 6901            	     3M         adc #1
00:C0E0 8D39C2          	     4M         sta seconds
00:C0E3 C960            	     5M         cmp #$60
00:C0E5 D029            	     6M         bne done$      
00:C0E7 A900            	     7M         lda #0
00:C0E9 8D39C2          	     8M         sta seconds
                        	   277:         bump minutes, $60, done$      ;; minutes < 60: no carry
00:C0EC 18              	     1M         clc
00:C0ED AD38C2          	     2M         lda minutes
00:C0F0 6901            	     3M         adc #1
00:C0F2 8D38C2          	     4M         sta minutes
00:C0F5 C960            	     5M         cmp #$60
00:C0F7 D017            	     6M         bne done$      
00:C0F9 A900            	     7M         lda #0
00:C0FB 8D38C2          	     8M         sta minutes
                        	   278:         bump hours, $24, done$        ;; hours < 24: no wrap
00:C0FE 18              	     1M         clc
00:C0FF AD37C2          	     2M         lda hours
00:C102 6901            	     3M         adc #1
00:C104 8D37C2          	     4M         sta hours
00:C107 C924            	     5M         cmp #$24
00:C109 D005            	     6M         bne done$        
00:C10B A900            	     7M         lda #0
00:C10D 8D37C2          	     8M         sta hours
                        	   279: done$:
00:C110 D8              	   280:         cld
00:C111 2003C2          	   281:         jsr print
                        	   282: exit$:
00:C114 68              	   283:         pla
00:C115 A8              	   284:         tay
00:C116 68              	   285:         pla
00:C117 AA              	   286:         tax
00:C118 68              	   287:         pla
00:C119 40              	   288:         rti
                        	   289: 
                        	   290:         ;; Routine to build the '0'-'9' and ':' sprite shapes
                        	   291:         ;; from the chargen ROM, then position, color and
                        	   292:         ;; point the 8 clock sprites at them.
                        	   293: initspr:
00:C11A 78              	   294:         sei
00:C11B D8              	   295:         cld
                        	   296: 
                        	   297:         ;; Preserve the visible screen before moving it from $0400
                        	   298:         ;; to $c400 in the new VIC bank.
00:C11C A900            	   299:         lda #$00
00:C11E 855B            	   300:         sta ptr1
00:C120 855D            	   301:         sta ptr2
00:C122 A904            	   302:         lda #$04
00:C124 855C            	   303:         sta ptr1+1
00:C126 A9C4            	   304:         lda #$c4
00:C128 855E            	   305:         sta ptr2+1
                        	   306:         copyblk ptr2, 4, 1
00:C12A A204            	     1M         ldx #4
                        	     2M :
00:C12C A000            	     3M         ldy #0
                        	     4M :
00:C12E B15B            	     5M         lda (ptr1),y
00:C130 915D            	     6M         sta (ptr2),y
00:C132 C8              	     7M         iny
00:C133 D0F9            	     8M         bne :-
00:C135 E65C            	     9M         inc ptr1+1
                        	    10M         .if 1
00:C137 E65E            	    11M         inc ptr2+1
                        	    12M         .endif
00:C139 CA              	    13M         dex
00:C13A D0F0            	    14M         bne :--
                        	   307: 
                        	   308:         ;; Copy all 2 KiB of the chargen ROM into the RAM beneath it.
                        	   309:         ;; Reads see ROM and writes to the same address reach RAM.
00:C13C A501            	   310:         lda $01
00:C13E 48              	   311:         pha                     ;save current CPU config
00:C13F A933            	   312:         lda #$33
00:C141 8501            	   313:         sta $01                 ;LORAM=1, HIRAM=1 CHAREN=0
00:C143 A900            	   314:         lda #$00
00:C145 855B            	   315:         sta ptr1
00:C147 A9D0            	   316:         lda #$d0
00:C149 855C            	   317:         sta ptr1+1
                        	   318:         copyblk ptr1, 8, 0
00:C14B A208            	     1M         ldx #8
                        	     2M :
00:C14D A000            	     3M         ldy #0
                        	     4M :
00:C14F B15B            	     5M         lda (ptr1),y
00:C151 915B            	     6M         sta (ptr1),y
00:C153 C8              	     7M         iny
00:C154 D0F9            	     8M         bne :-
00:C156 E65C            	     9M         inc ptr1+1
                        	    10M         .if 0
                        	    11M         inc ptr1+1
                        	    12M         .endif
00:C158 CA              	    13M         dex
00:C159 D0F2            	    14M         bne :--
                        	   319: 
                        	   320:         ;; 11 glyphs: src = $d180 + g*8 ('0' = ASCII $30),
                        	   321:         ;;            dst = $c800 + g*64.
00:C15B A900            	   322:         lda #<glyphs
00:C15D 855B            	   323:         sta ptr1
00:C15F A9C8            	   324:         lda #>glyphs
00:C161 855C            	   325:         sta ptr1+1
00:C163 A200            	   326:         ldx #0
                        	   327: gly$:
00:C165 8A              	   328:         txa
00:C166 0A              	   329:         asl
00:C167 0A              	   330:         asl
00:C168 0A              	   331:         asl
00:C169 18              	   332:         clc
00:C16A 6980            	   333:         adc #$80
00:C16C 855D            	   334:         sta ptr2
00:C16E A9D1            	   335:         lda #$d1
00:C170 855E            	   336:         sta ptr2+1           ;; src = $d100 + $80 + g*8
00:C172 A900            	   337:         lda #0               ;; clear the 64-byte sprite block
00:C174 A03F            	   338:         ldy #63
                        	   339: zro$:
00:C176 915B            	   340:         sta (ptr1),y
00:C178 88              	   341:         dey
00:C179 10FB            	   342:         bpl zro$
00:C17B A000            	   343:         ldy #0               ;; glyph row n -> sprite byte n*3
                        	   344: row$:
00:C17D B15D            	   345:         lda (ptr2),y
00:C17F 48              	   346:         pha
00:C180 98              	   347:         tya
00:C181 85FA            	   348:         sta temp
00:C183 0A              	   349:         asl
00:C184 65FA            	   350:         adc temp             ;; 3*n
00:C186 A8              	   351:         tay
00:C187 68              	   352:         pla
00:C188 915B            	   353:         sta (ptr1),y
00:C18A A4FA            	   354:         ldy temp
00:C18C C8              	   355:         iny
00:C18D C008            	   356:         cpy #8
00:C18F D0EC            	   357:         bne row$
00:C191 18              	   358:         clc                  ;; advance to the next sprite block
00:C192 A55B            	   359:         lda ptr1
00:C194 6940            	   360:         adc #64
00:C196 855B            	   361:         sta ptr1
00:C198 9002            	   362:         bcc nxt$
00:C19A E65C            	   363:         inc ptr1+1
                        	   364: nxt$:
00:C19C E8              	   365:         inx
00:C19D E00B            	   366:         cpx #11
00:C19F D0C4            	   367:         bne gly$
                        	   368: 
                        	   369:         ;; Restore I/O visibility before touching CIA2 or VIC-II.
00:C1A1 68              	   370:         pla
00:C1A2 8501            	   371:         sta $01
                        	   372: 
                        	   373:         ;; VIC bank $c000-$ffff: CIA2 PRA bits 0-1 = %00.
00:C1A4 A903            	   374:         lda #3                  ;configure the DDR so bits 0-1
00:C1A6 0D02DD          	   375:         ora c2ddra              ;are output bits
00:C1A9 8D02DD          	   376:         sta c2ddra
00:C1AC AD00DD          	   377:         lda ci2pra
00:C1AF 29FC            	   378:         and #$fc                ;select VIC bank 3 ($c000-$ffff)
00:C1B1 8D00DD          	   379:         sta ci2pra
                        	   380: 
                        	   381:         ;; Screen = $0400, charset = $1000 (bank offsets):
                        	   382:         ;; physical $c400 screen (pointers at $c7f8-$c7ff) and
                        	   383:         ;; the charset copied to RAM at $d000.
00:C1B4 A90F            	   384:         lda #$0f
00:C1B6 2D18D0          	   385:         and vmcsb
00:C1B9 0910            	   386:         ora #$10
00:C1BB 8D18D0          	   387:         sta vmcsb
00:C1BE A9F1            	   388:         lda #$f1
00:C1C0 2D18D0          	   389:         and vmcsb
00:C1C3 0904            	   390:         ora #$04
00:C1C5 8D18D0          	   391:         sta vmcsb
                        	   392: 
                        	   393:         ;; Tell the KERNAL screen editor about the relocated screen,
                        	   394:         ;; then refresh its pointers for the current cursor position.
00:C1C8 A9C4            	   395:         lda #$c4
00:C1CA 8D8802          	   396:         sta hibase
00:C1CD 206CE5          	   397:         jsr setpnt
                        	   398: 
                        	   399:         ;; sprite X positions (low bytes; hi bits set below):
                        	   400:         ;; cols 32-39 => X = sprx0 + i*8, i.e. 280,288,...,336.
00:C1D0 A200            	   401:         ldx #0
                        	   402: xlo$:
00:C1D2 8A              	   403:         txa
00:C1D3 0A              	   404:         asl
00:C1D4 0A              	   405:         asl
00:C1D5 18              	   406:         clc
00:C1D6 6918            	   407:         adc #<sprx0
00:C1D8 9D00D0          	   408:         sta sprxlo,x
00:C1DB E8              	   409:         inx
00:C1DC E8              	   410:         inx
00:C1DD E010            	   411:         cpx #16
00:C1DF D0F1            	   412:         bne xlo$
                        	   413:         ;; sprite Y positions: all on text row 24 (Y = 50+24*8 = 242)
00:C1E1 A9F2            	   414:         lda #spry0
00:C1E3 A20E            	   415:         ldx #14
                        	   416: ylo$:
00:C1E5 9D01D0          	   417:         sta sprylo,x
00:C1E8 CA              	   418:         dex
00:C1E9 CA              	   419:         dex
00:C1EA 10F9            	   420:         bpl ylo$
                        	   421:         ;; colors: all white
00:C1EC A901            	   422:         lda #$01
00:C1EE A207            	   423:         ldx #7
                        	   424: col$:
00:C1F0 9D27D0          	   425:         sta sp0col,x
00:C1F3 CA              	   426:         dex
00:C1F4 10FA            	   427:         bpl col$
                        	   428:         ;; enable sprites, set all X high bits (cols 32-39)
00:C1F6 A9FF            	   429:         lda #$ff
00:C1F8 8D10D0          	   430:         sta sprxhi
00:C1FB 8D15D0          	   431:         sta spena
                        	   432:         ;; draw the current time immediately
00:C1FE 2003C2          	   433:         jsr print
00:C201 58              	   434:         cli
00:C202 60              	   435:         rts
                        	   436: 
                        	   437:         ;; Routine to update the 8 clock sprites
                        	   438:         ;; from the BCD time (HH:MM:SS).
                        	   439: print:
00:C203 A200            	   440:         ldx #0           ;; sprite index
00:C205 AD37C2          	   441:         lda hours
00:C208 2029C2          	   442:         jsr digits$
00:C20B A90A            	   443:         lda #10          ;; ':'
00:C20D 2021C2          	   444:         jsr putdgt$
00:C210 AD38C2          	   445:         lda minutes
00:C213 2029C2          	   446:         jsr digits$
00:C216 A90A            	   447:         lda #10          ;; ':'
00:C218 2021C2          	   448:         jsr putdgt$
00:C21B AD39C2          	   449:         lda seconds
00:C21E 4C29C2          	   450:         jmp digits$
                        	   451: 
                        	   452:         ;; Write sprite pointer for glyph index in .A
                        	   453: putdgt$:
00:C221 18              	   454:         clc
00:C222 6920            	   455:         adc #sprbase
00:C224 9DF8C7          	   456:         sta sprptr,x
00:C227 E8              	   457:         inx
00:C228 60              	   458:         rts
                        	   459: 
                        	   460:         ;; Write pointers for the two BCD digits of .A
                        	   461: digits$:
00:C229 48              	   462:         pha
00:C22A 4A              	   463:         lsr
00:C22B 4A              	   464:         lsr
00:C22C 4A              	   465:         lsr
00:C22D 4A              	   466:         lsr
00:C22E 2021C2          	   467:         jsr putdgt$       ;; tens digit
00:C231 68              	   468:         pla
00:C232 290F            	   469:         and #$0f
00:C234 4C21C2          	   470:         jmp putdgt$       ;; ones digit
                        	   471: 
                        	   472:         ;; Persistent state must not use zero page: BASIC and the
                        	   473:         ;; KERNAL use almost all of it as volatile working storage.
00:C237 00              	   474: hours:   .byte 0          ;; Time in hours BCD
00:C238 00              	   475: minutes: .byte 0          ;; Time in minutes BCD
00:C239 00              	   476: seconds: .byte 0          ;; Time in seconds BCD


