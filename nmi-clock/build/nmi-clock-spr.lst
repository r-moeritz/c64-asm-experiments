Sections:
00: "org0001:c000" (C000-C20E)


Source: "src/nmi-clock-spr.asm"
                        	     1:         ;; NMI-based clock/timer using sprites
                        	     2:         ;; ===================================
                        	     3:         ;;
                        	     4:         ;; CIA2 timers A+B cascaded -> 1 NMI/second (PAL)
                        	     5:         ;; HH:MM:SS clock (BCD sec/min/hour) displayed with
                        	     6:         ;; 8 sprites in the bottom-right corner of the screen.
                        	     7:         ;; The 8x8 glyphs are copied from the C64 character
                        	     8:         ;; ROM into the top-left corner of 64-byte sprite
                        	     9:         ;; blocks (11 glyphs: digits 0-9 and ':').
                        	    10:         ;; -----------------------------------------------
                        	    11:         ;; Timer A = 20455 (~50.008 Hz on PAL 1.022727 MHz
                        	    12:         ;; CIA clock); timer B counts 50 underflows -> ~1s
                        	    13: 
                        	    14:         ;; Macros
                        	    15:         ;; ------
                        	    16: 
                        	    17:         ;; BNE to distant address
                        	    18: jne:    .macro adr
                        	    19:         beq :+
                        	    20:         jmp \adr
                        	    21: :
                        	    22:         .endm
                        	    23: 
                        	    24:         ;; BCS to distant address
                        	    25: jcs:    .macro adr
                        	    26:         bcc :+
                        	    27:         jmp \adr
                        	    28: :
                        	    29:         .endm
                        	    30: 
                        	    31:         ;; CIA2 registers
                        	    32:         ;; --------------
                        	    33: ci2tia: .equ $dd04              ;.word Timer A
                        	    34: ci2tib: .equ $dd06              ;.word Timer B
                        	    35: ci2icr: .equ $dd0d              ;.byte Interrupt ctrl register
                        	    36: ci2cra: .equ $dd0e              ;.byte Timer A ctrl register
                        	    37: ci2crb: .equ $dd0f              ;.byte Timer B ctrl register
                        	    38: 
                        	    39:         ;; VIC-II registers
                        	    40:         ;; -----------------
                        	    41: sprxlo: .equ $d000              ;.byte sprite X positions (low)
                        	    42: sprylo: .equ $d001              ;.byte sprite Y positions
                        	    43: sprxhi: .equ $d010              ;.byte sprite X positions (high)
                        	    44: sprenab:.equ $d015              ;.byte sprite enable
                        	    45: spcolor:.equ $d027              ;.byte sprite colors (0-7)
                        	    46: 
                        	    47:         ;; System Memory Locations
                        	    48:         ;; -----------------------
                        	    49: nmivec: .equ $0318              ;kernal indirect NMI vector
                        	    50: sprptr: .equ $07f8              ;sprite data pointers (top of screen RAM)
                        	    51: glyphs: .equ $3000              ;sprite glyph buffer (must be < $4000)
                        	    52: 
                        	    53:         ;; Sprite anchor = top-left pixel of the first clock cell at
                        	    54:         ;; screen RAM $07e0 (text row 24, column 32).
                        	    55:         ;;
                        	    56:         ;; VIC-II sprite coordinates are measured from the top-left of
                        	    57:         ;; the border, NOT the visible screen.  The visible text area
                        	    58:         ;; starts at sprite coordinate X = 24, Y = 50, so a text cell
                        	    59:         ;; (col,row) maps to:
                        	    60:         ;;     sprite X = 24 + col*8     sprite Y = 50 + row*8
                        	    61:         ;;
                        	    62:         ;; Sprite 0 is the left-most column (32).
                        	    63: sprx0:  .equ 24 + (32*8)            ;sprite 0 X (col 32 -> sprite X 280)
                        	    64: spry0:  .equ 50 + (24*8)            ;sprite Y  (row 24 -> sprite Y 242)
                        	    65: 
                        	    66:         ;; OS routines
                        	    67:         ;; -----------
                        	    68: frmnum: .equ $ad8a              ;eval numeric expression
                        	    69: comma:  .equ $aefd              ;detect comma in BASIC line
                        	    70: facwrd: .equ $b7f7              ;convert FAC #1 to word at linnum
                        	    71: illqua: .equ $b248              ;raise illegal qty error
                        	    72: 
                        	    73:         ;; OS memory
                        	    74:         ;; ---------
                        	    75: linnum: .ezp $14                ;.word BASIC line number
                        	    76: 
                        	    77:         ;; Working memory (ZP)
                        	    78:         ;; -------------------
                        	    79: hours:    .ezp $f7                ;.byte Time in hours BCD
                        	    80: minutes:  .ezp $f8                ;.byte Time in minutes BCD
                        	    81: seconds:  .ezp $f9                ;.byte Time in seconds BCD
                        	    82: temp:     .ezp $fa                ;.byte Scratch pad
                        	    83: ptr1:     .ezp $5b                ;.word Scratch pointer
                        	    84: ptr2:     .ezp $5d                ;.word Scratch pointer
                        	    85: sprbase:  .ezp $5f                ;.byte Sprite pointer base (glyphs>>6)
                        	    86: 
                        	    87:         .org $c000
                        	    88: 
                        	    89:         ;; Jump table
                        	    90:         ;; ----------
00:C000 4C0CC0          	    91: jtable: jmp settime
00:C003 4C63C0          	    92:         jmp start
00:C006 4C97C0          	    93:         jmp stop
00:C009 4CA0C0          	    94:         jmp restart
                        	    95: 
                        	    96:         ;; Routines
                        	    97:         ;; --------
                        	    98: 
                        	    99:         ;; Routine to set the time from user input
                        	   100:         ;; and start the clock.
                        	   101:         ;; Called from BASIC via jump table entry:
                        	   102:         ;;      SYS(49152) hrs (0-23), min (0-59), sec (0-59)
                        	   103:         ;;
                        	   104:         ;; E.g. SYS(49152) 11,51,20
                        	   105: settime:
                        	   106:         ;; Hours
00:C00C 205DC0          	   107:         jsr getwrd$
00:C00F A515            	   108:         lda linnum+1
                        	   109:         jne illqua
00:C011 F003            	     1M         beq :+
00:C013 4C48B2          	     2M         jmp illqua
                        	     3M :
00:C016 A514            	   110:         lda linnum
00:C018 C918            	   111:         cmp #24
                        	   112:         jcs illqua
00:C01A 9003            	     1M         bcc :+
00:C01C 4C48B2          	     2M         jmp illqua
                        	     3M :
00:C01F 20AEC0          	   113:         jsr bin2bcd
00:C022 85F7            	   114:         sta hours
                        	   115:         ;; Minutes
00:C024 20FDAE          	   116:         jsr comma
00:C027 205DC0          	   117:         jsr getwrd$
00:C02A A515            	   118:         lda linnum+1
                        	   119:         jne illqua
00:C02C F003            	     1M         beq :+
00:C02E 4C48B2          	     2M         jmp illqua
                        	     3M :
00:C031 A514            	   120:         lda linnum
00:C033 C93C            	   121:         cmp #60
                        	   122:         jcs illqua
00:C035 9003            	     1M         bcc :+
00:C037 4C48B2          	     2M         jmp illqua
                        	     3M :
00:C03A 20AEC0          	   123:         jsr bin2bcd
00:C03D 85F8            	   124:         sta minutes
                        	   125:         ;; Seconds
00:C03F 20FDAE          	   126:         jsr comma
00:C042 205DC0          	   127:         jsr getwrd$
00:C045 A515            	   128:         lda linnum+1
                        	   129:         jne illqua
00:C047 F003            	     1M         beq :+
00:C049 4C48B2          	     2M         jmp illqua
                        	     3M :
00:C04C A514            	   130:         lda linnum
00:C04E C93C            	   131:         cmp #60
                        	   132:         jcs illqua
00:C050 9003            	     1M         bcc :+
00:C052 4C48B2          	     2M         jmp illqua
                        	     3M :
00:C055 20AEC0          	   133:         jsr bin2bcd
00:C058 85F9            	   134:         sta seconds
00:C05A 4C63C0          	   135:         jmp start
                        	   136: 
                        	   137: getwrd$:
00:C05D 208AAD          	   138:         jsr frmnum
00:C060 4CF7B7          	   139:         jmp facwrd
                        	   140: 
                        	   141:         ;; Routine to start the NMI timer
                        	   142:         ;; Called from BASIC via jump table entry:
                        	   143:         ;;      SYS49155
                        	   144: start:
00:C063 200EC1          	   145:         jsr initgfx      ;; build sprite glyphs, position/enable sprites
                        	   146: 
00:C066 A9E7            	   147:         lda #$e7         ;; timer A = 20,455 (PAL)
00:C068 8D04DD          	   148:         sta ci2tia
00:C06B A94F            	   149:         lda #$4f
00:C06D 8D05DD          	   150:         sta ci2tia+1
00:C070 A932            	   151:         lda #50          ;; timer B = 50 A-underflows
00:C072 8D06DD          	   152:         sta ci2tib
00:C075 A900            	   153:         lda #0
00:C077 8D07DD          	   154:         sta ci2tib+1
                        	   155: 
00:C07A A911            	   156:         lda #%00010001
00:C07C 8D0EDD          	   157:         sta ci2cra       ;; start timer A
00:C07F A951            	   158:         lda #%01010001
00:C081 8D0FDD          	   159:         sta ci2crb       ;; B counts A underflows, start
                        	   160: 
00:C084 AD0DDD          	   161:         lda ci2icr
00:C087 0982            	   162:         ora #%10000010
00:C089 8D0DDD          	   163:         sta ci2icr       ;; enable timer B -> NMI
                        	   164: 
00:C08C A9C9            	   165:         lda #<isr        ;; hook NMI
00:C08E 8D1803          	   166:         sta nmivec
00:C091 A9C0            	   167:         lda #>isr
00:C093 8D1903          	   168:         sta nmivec+1
00:C096 60              	   169:         rts
                        	   170: 
                        	   171:         ;; Routine to stop the NMI timer
                        	   172:         ;; Called from BASIC via jump table entry:
                        	   173:         ;;      SYS49158
                        	   174: stop:
00:C097 A97F            	   175:         lda #$7f
00:C099 8D0DDD          	   176:         sta ci2icr
00:C09C AD0DDD          	   177:         lda ci2icr
00:C09F 60              	   178:         rts
                        	   179: 
                        	   180:         ;; Routine to stop timer, reset time to 00:00:00
                        	   181:         ;; and then restart timer.
                        	   182:         ;; Called from BASIC via jump table entry:
                        	   183:         ;;      SYS49161
                        	   184: restart:
00:C0A0 2097C0          	   185:         jsr stop
00:C0A3 A900            	   186:         lda #0
00:C0A5 85F7            	   187:         sta hours
00:C0A7 85F8            	   188:         sta minutes
00:C0A9 85F9            	   189:         sta seconds
00:C0AB 4C63C0          	   190:         jmp start
                        	   191: 
                        	   192:         ;; Routine to convert byte in .A to packed BCD
                        	   193: bin2bcd:
00:C0AE A200            	   194:         ldx #0
00:C0B0 A8              	   195:         tay
                        	   196: loop$:
00:C0B1 C00A            	   197:         cpy #10
00:C0B3 9009            	   198:         bcc endloop$
00:C0B5 98              	   199:         tya
00:C0B6 38              	   200:         sec
00:C0B7 E90A            	   201:         sbc #10
00:C0B9 A8              	   202:         tay
00:C0BA E8              	   203:         inx
00:C0BB 4CB1C0          	   204:         jmp loop$
                        	   205: endloop$:
00:C0BE 8A              	   206:         txa
00:C0BF 0A              	   207:         asl
00:C0C0 0A              	   208:         asl
00:C0C1 0A              	   209:         asl
00:C0C2 0A              	   210:         asl
00:C0C3 85FA            	   211:         sta temp
00:C0C5 98              	   212:         tya
00:C0C6 05FA            	   213:         ora temp
00:C0C8 60              	   214:         rts
                        	   215: 
                        	   216:         ;; NMI service routine: called once per second
                        	   217: isr:
                        	   218:         ;; Save x,y,acc
00:C0C9 48              	   219:         pha
00:C0CA 8A              	   220:         txa
00:C0CB 48              	   221:         pha
00:C0CC 98              	   222:         tya
00:C0CD 48              	   223:         pha
                        	   224: 
00:C0CE AC0DDD          	   225:         ldy ci2icr       ;; read clears pending flag
00:C0D1 98              	   226:         tya
00:C0D2 2902            	   227:         and #$02
00:C0D4 F032            	   228:         beq endisr$
                        	   229: 
00:C0D6 F8              	   230:         sed               ;; BCD +1 second, with 60/60/24 rollover
00:C0D7 18              	   231:         clc
00:C0D8 A5F9            	   232:         lda seconds
00:C0DA 6901            	   233:         adc #1
00:C0DC 85F9            	   234:         sta seconds
00:C0DE C960            	   235:         cmp #$60
00:C0E0 D022            	   236:         bne done$         ;; seconds < 60: no carry
                        	   237: 
00:C0E2 A900            	   238:         lda #0            ;; seconds == 60 -> wrap to :00
00:C0E4 85F9            	   239:         sta seconds
00:C0E6 18              	   240:         clc
00:C0E7 A5F8            	   241:         lda minutes
00:C0E9 6901            	   242:         adc #1
00:C0EB 85F8            	   243:         sta minutes
00:C0ED C960            	   244:         cmp #$60
00:C0EF D013            	   245:         bne done$         ;; minutes < 60: no carry
                        	   246: 
00:C0F1 A900            	   247:         lda #0            ;; minutes == 60 -> wrap to :00
00:C0F3 85F8            	   248:         sta minutes
00:C0F5 18              	   249:         clc
00:C0F6 A5F7            	   250:         lda hours
00:C0F8 6901            	   251:         adc #1
00:C0FA 85F7            	   252:         sta hours
00:C0FC C924            	   253:         cmp #$24
00:C0FE D004            	   254:         bne done$         ;; hours < 24: no wrap
                        	   255: 
00:C100 A900            	   256:         lda #0            ;; hours == 24 -> wrap to 00
00:C102 85F7            	   257:         sta hours
                        	   258: done$:
00:C104 D8              	   259:         cld
00:C105 20DCC1          	   260:         jsr print
                        	   261: endisr$:
00:C108 68              	   262:         pla
00:C109 A8              	   263:         tay
00:C10A 68              	   264:         pla
00:C10B AA              	   265:         tax
00:C10C 68              	   266:         pla
00:C10D 40              	   267:         rti
                        	   268: 
                        	   269:         ;; Routine to copy characters '0'-'9' and ':' from
                        	   270:         ;; the character ROM into the top-left 8x8 corner
                        	   271:         ;; of 11 sprite blocks at 'glyphs', then position
                        	   272:         ;; and enable the 8 clock sprites.
                        	   273: initgfx:
00:C10E 78              	   274:         sei
00:C10F A501            	   275:         lda $01
00:C111 48              	   276:         pha
00:C112 29FB            	   277:         and #%11111011   ;; CHAREN low -> chargen visible at $d000
00:C114 8501            	   278:         sta $01
                        	   279: 
                        	   280:         ;; Build 11 glyph blocks (digits 0-9, then ':')
00:C116 A200            	   281:         ldx #0           ;; glyph index
                        	   282: ig_loop$:
                        	   283:         ;; dest = glyphs + X*64
00:C118 A900            	   284:         lda #<glyphs
00:C11A 855B            	   285:         sta ptr1
00:C11C A930            	   286:         lda #>glyphs
00:C11E 855C            	   287:         sta ptr1+1
00:C120 8A              	   288:         txa
00:C121 F013            	   289:         beq ig_hav$
00:C123 86FA            	   290:         stx temp
                        	   291: ig_add$:
00:C125 18              	   292:         clc
00:C126 A55B            	   293:         lda ptr1
00:C128 6940            	   294:         adc #64
00:C12A 855B            	   295:         sta ptr1
00:C12C A55C            	   296:         lda ptr1+1
00:C12E 6900            	   297:         adc #0
00:C130 855C            	   298:         sta ptr1+1
00:C132 C6FA            	   299:         dec temp
00:C134 D0EF            	   300:         bne ig_add$
                        	   301: ig_hav$:
                        	   302:         ;; src = $d180 + X*8 ('0' is the first glyph)
00:C136 8A              	   303:         txa
00:C137 0A              	   304:         asl
00:C138 0A              	   305:         asl
00:C139 0A              	   306:         asl
00:C13A 18              	   307:         clc
00:C13B 6980            	   308:         adc #$80
00:C13D 855D            	   309:         sta ptr2
00:C13F A9D1            	   310:         lda #$d1
00:C141 6900            	   311:         adc #0
00:C143 855E            	   312:         sta ptr2+1
                        	   313:         ;; zero the whole 64-byte sprite block first
00:C145 A000            	   314:         ldy #0
                        	   315: ig_zero$:
00:C147 A900            	   316:         lda #0
00:C149 915B            	   317:         sta (ptr1),y
00:C14B C8              	   318:         iny
00:C14C C040            	   319:         cpy #64
00:C14E D0F7            	   320:         bne ig_zero$
                        	   321:         ;; Copy the 8 glyph rows into the left 8 columns of the
                        	   322:         ;; sprite.  A sprite row is 3 bytes wide (24 px), so glyph
                        	   323:         ;; row N must go to byte offset N*3 (not N): the glyph
                        	   324:         ;; occupies bytes 0,3,6,...,21 of the sprite block.
00:C150 A000            	   325:         ldy #0
                        	   326: ig_inner$:
00:C152 B15D            	   327:         lda (ptr2),y     ;; glyph row Y (0..7)
00:C154 48              	   328:         pha
00:C155 98              	   329:         tya
00:C156 85FA            	   330:         sta temp         ;; temp = Y (glyph row)
00:C158 0A              	   331:         asl              ;; Y*2
00:C159 18              	   332:         clc
00:C15A 65FA            	   333:         adc temp         ;; Y*3 -> byte offset of sprite row Y
00:C15C A8              	   334:         tay
00:C15D 68              	   335:         pla
00:C15E 915B            	   336:         sta (ptr1),y     ;; store glyph row in left column
00:C160 A4FA            	   337:         ldy temp         ;; restore glyph row counter
00:C162 C8              	   338:         iny
00:C163 C008            	   339:         cpy #8
00:C165 D0EB            	   340:         bne ig_inner$
00:C167 E8              	   341:         inx
00:C168 E00B            	   342:         cpx #11
00:C16A D0AC            	   343:         bne ig_loop$
                        	   344: 
                        	   345:         ;; restore memory config
00:C16C 68              	   346:         pla
00:C16D 8501            	   347:         sta $01
00:C16F 58              	   348:         cli
                        	   349: 
                        	   350:         ;; sprite X positions (low registers at $d000,$d002,...):
                        	   351:         ;; cols 32-39 => X = sprx0 + i*8, i.e. 280,288,...,336.
                        	   352:         ;; The low byte written here (24..80) is sprx0&$ff + i*8;
                        	   353:         ;; the high bit is provided by sprxhi=$ff below.
00:C170 A200            	   354:         ldx #0
                        	   355: ig_xl$:
00:C172 8A              	   356:         txa
00:C173 0A              	   357:         asl
00:C174 0A              	   358:         asl
00:C175 18              	   359:         clc
00:C176 6918            	   360:         adc #<sprx0
00:C178 9D00D0          	   361:         sta sprxlo,x
00:C17B E8              	   362:         inx
00:C17C E8              	   363:         inx
00:C17D E010            	   364:         cpx #16
00:C17F D0F1            	   365:         bne ig_xl$
                        	   366:         ;; sprite Y positions: all on the last text row 24
                        	   367:         ;; (sprite Y = 50 + 24*8 = 242)
00:C181 A9F2            	   368:         lda #spry0
00:C183 8D01D0          	   369:         sta sprylo
00:C186 8D03D0          	   370:         sta sprylo+2
00:C189 8D05D0          	   371:         sta sprylo+4
00:C18C 8D07D0          	   372:         sta sprylo+6
00:C18F 8D09D0          	   373:         sta sprylo+8
00:C192 8D0BD0          	   374:         sta sprylo+10
00:C195 8D0DD0          	   375:         sta sprylo+12
00:C198 8D0FD0          	   376:         sta sprylo+14
                        	   377:         ;; colors = white
00:C19B A901            	   378:         lda #$01
00:C19D 8D27D0          	   379:         sta spcolor
00:C1A0 8D28D0          	   380:         sta spcolor+1
00:C1A3 8D29D0          	   381:         sta spcolor+2
00:C1A6 8D2AD0          	   382:         sta spcolor+3
00:C1A9 8D2BD0          	   383:         sta spcolor+4
00:C1AC 8D2CD0          	   384:         sta spcolor+5
00:C1AF 8D2DD0          	   385:         sta spcolor+6
00:C1B2 8D2ED0          	   386:         sta spcolor+7
                        	   387:         ;; enable all sprites, all X hi bits
00:C1B5 A9FF            	   388:         lda #$ff
00:C1B7 8D10D0          	   389:         sta sprxhi
00:C1BA 8D15D0          	   390:         sta sprenab
                        	   391:         ;; sprite pointer base = glyphs>>6
00:C1BD A900            	   392:         lda #<glyphs
00:C1BF 4A              	   393:         lsr
00:C1C0 4A              	   394:         lsr
00:C1C1 4A              	   395:         lsr
00:C1C2 4A              	   396:         lsr
00:C1C3 4A              	   397:         lsr
00:C1C4 4A              	   398:         lsr
00:C1C5 85FA            	   399:         sta temp
00:C1C7 A930            	   400:         lda #>glyphs
00:C1C9 0A              	   401:         asl
00:C1CA 0A              	   402:         asl
00:C1CB 05FA            	   403:         ora temp
00:C1CD 855F            	   404:         sta sprbase
                        	   405:         ;; initial display: 00:00:00
00:C1CF A200            	   406:         ldx #0
00:C1D1 A55F            	   407:         lda sprbase
                        	   408: ig_ptr$:
00:C1D3 9DF807          	   409:         sta sprptr,x
00:C1D6 E8              	   410:         inx
00:C1D7 E008            	   411:         cpx #8
00:C1D9 D0F8            	   412:         bne ig_ptr$
00:C1DB 60              	   413:         rts
                        	   414: 
                        	   415:         ;; Routine to update the 8 clock sprites
                        	   416:         ;; from the BCD time (HH:MM:SS).
                        	   417: print:
00:C1DC A200            	   418:         ldx #0           ;; sprite index
00:C1DE A5F7            	   419:         lda hours
00:C1E0 2000C2          	   420:         jsr digits$
00:C1E3 A90A            	   421:         lda #10          ;; ':'
00:C1E5 20F8C1          	   422:         jsr putdgt$
00:C1E8 A5F8            	   423:         lda minutes
00:C1EA 2000C2          	   424:         jsr digits$
00:C1ED A90A            	   425:         lda #10          ;; ':'
00:C1EF 20F8C1          	   426:         jsr putdgt$
00:C1F2 A5F9            	   427:         lda seconds
00:C1F4 2000C2          	   428:         jsr digits$
00:C1F7 60              	   429:         rts
                        	   430: 
                        	   431:         ;; Write sprite pointer for glyph index in .A
                        	   432: putdgt$:
